---
import Base from '../layouts/Base.astro';
import { getMeta } from '../utils/data';
const meta = getMeta();
---

<Base title="About" current="about" description="About ref-ball — Harris Gordon's open NBA officiating research.">
  <section class="section">
    <div class="container prose">
      <h1 class="display">About</h1>
      <p class="lead">
        Independent basketball analytics by <strong>{meta.author}</strong>. Three research projects on how NBA
        officiating shapes player outcomes — with open data.
      </p>
      <h2>Open data</h2>
      <p>
        Dataset: <strong>{meta.license.data}</strong>. Code: <strong>{meta.license.code}</strong>. Officials are named
        by design — anonymization would remove the dataset's primary value.
      </p>
      <h2>Reproducibility</h2>
      <p>
        The ref-ball pipeline is reproducible from the repo Makefile. This site is generated by
        <code>site/scripts/build_site_data.py</code> — the frontend never reads parquet.
      </p>
      <p><a href={meta.github_url}>Source on GitHub →</a></p>
    </div>
  </section>
</Base>
