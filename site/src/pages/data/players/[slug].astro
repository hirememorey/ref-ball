---
import Base from '../../../layouts/Base.astro';
import StatTile from '../../../components/StatTile.astro';
import WindowChrome from '../../../components/WindowChrome.astro';
import { deltaClass, formatNum, formatSigned, getPlayer, getPlayerSlugs } from '../../../utils/data';

export function getStaticPaths() {
  return getPlayerSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const player = getPlayer(slug!);
const b = player.baseline;
---

<Base title={player.player_name as string} current="data" description={`${player.player_name} — FTA deltas across officials.`}>
  <section class="section page-header page-header--workspace">
    <div class="container">
      <p class="breadcrumb"><a href="/data/players">Players</a> / {player.player_name}</p>
      <h1 class="display">{player.player_name}</h1>
      <div class="stat-row">
        <StatTile label="Baseline FTA/game" value={formatNum(b.baseline_fta_per_game as number | null)} />
        <StatTile label="Baseline SF/game" value={formatNum(b.baseline_sf_per_game as number | null, 3)} />
        <StatTile label="Games w/o official sample" value={String(b.n_games_without_official ?? '—')} />
      </div>
    </div>
  </section>

  <section class="section section--alt section--dither section--flush-top">
    <div class="container">
      <WindowChrome title="official_deltas.csv" showStatus status="Click headers to sort">
        <div class="toggle-row">
          <button type="button" class="toggle-btn active" data-view="adj">Defense-adjusted FTA/36</button>
          <button type="button" class="toggle-btn" data-view="raw">Raw FTA deltas</button>
        </div>
        <div class="filter-row">
          <label for="min-games">Min games with official:</label>
          <input type="range" id="min-games" min="1" max="20" value="1" />
          <span id="min-games-val" class="mono">1</span>
        </div>

        <div class="table-wrap" id="table-adj">
          <table class="data-table" id="adj-table">
            <thead>
              <tr>
                <th>Official</th>
                <th class="num">Games</th>
                <th class="num">FTA/36 with</th>
                <th class="num">FTA/36 without</th>
                <th class="num">Adj Δ</th>
              </tr>
            </thead>
            <tbody>
              {player.defense_adjusted.map((row) => {
                const adj = row.defense_adjusted_fta36_delta as number | null;
                const ng = row.n_games_with as number | null;
                return (
                  <tr data-n-games={ng ?? 0}>
                    <td>
                      {row.official_id ? (
                        <a href={`/data/officials/${row.official_id}`}>{row.official_name}</a>
                      ) : (
                        row.official_name
                      )}
                    </td>
                    <td class="num">{ng ?? '—'}</td>
                    <td class="num mono">{formatNum(row.fta36_with as number | null)}</td>
                    <td class="num mono">{formatNum(row.fta36_without as number | null)}</td>
                    <td class={`num ${deltaClass(adj)}`}>{formatSigned(adj)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>

        <div class="table-wrap hidden" id="table-raw">
          <table class="data-table" id="raw-table">
            <thead>
              <tr>
                <th>Official</th>
                <th class="num">Games</th>
                <th class="num">FTA/g with</th>
                <th class="num">FTA/g without</th>
                <th class="num">Δ</th>
              </tr>
            </thead>
            <tbody>
              {player.official_deltas.map((row) => {
                const d = row.fta_delta as number | null;
                const ng = row.n_games_with as number | null;
                return (
                  <tr data-n-games={ng ?? 0}>
                    <td>
                      {row.official_id ? (
                        <a href={`/data/officials/${row.official_id}`}>{row.official_name}</a>
                      ) : (
                        row.official_name
                      )}
                    </td>
                    <td class="num">{ng ?? '—'}</td>
                    <td class="num mono">{formatNum(row.fta_per_game_with as number | null)}</td>
                    <td class="num mono">{formatNum(row.fta_per_game_without as number | null)}</td>
                    <td class={`num ${deltaClass(d)}`}>{formatSigned(d)}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </WindowChrome>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const btns = document.querySelectorAll('[data-view]');
    const adj = document.getElementById('table-adj');
    const raw = document.getElementById('table-raw');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.remove('active'));
      b.classList.add('active');
      const v = b.getAttribute('data-view');
      adj?.classList.toggle('hidden', v !== 'adj');
      raw?.classList.toggle('hidden', v !== 'raw');
    }));

    const slider = document.getElementById('min-games');
    const label = document.getElementById('min-games-val');
    const filter = () => {
      const min = Number(slider?.value || 1);
      if (label) label.textContent = String(min);
      document.querySelectorAll('#adj-table tbody tr, #raw-table tbody tr').forEach((row) => {
        const n = Number(row.getAttribute('data-n-games') || 0);
        row.style.display = n >= min ? '' : 'none';
      });
    };
    slider?.addEventListener('input', filter);
    filter();
  })();
</script>
