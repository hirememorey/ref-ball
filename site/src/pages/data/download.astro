---
import Base from '../../layouts/Base.astro';
import WindowChrome from '../../components/WindowChrome.astro';
import { getMeta } from '../../utils/data';

const meta = getMeta();
const citation = `@misc{refball${meta.git_sha},
  author = {Harris Gordon},
  title = {ref-ball: Per-official NBA shooting-foul attribution},
  year = {2026},
  howpublished = {${meta.github_url}},
  note = {Dataset built from commit ${meta.git_sha}}
}`;
const release = `${meta.github_url}/releases`;

const datasets = [
  {
    stem: 'official_calling_profiles',
    description: `${meta.counts.officials} officials — suppressor scores`,
  },
  {
    stem: 'player_official_interactions',
    description: `${meta.counts.player_official_pairs_raw.toLocaleString()} raw pairs`,
  },
  {
    stem: 'defensive_adjusted_interactions',
    description: `${meta.counts.player_official_pairs_adjusted.toLocaleString()} adjusted pairs`,
  },
  {
    stem: 'ref_profiles',
    description: 'Per-official SF rates (RS/PO)',
  },
  {
    stem: 'crew_assignments',
    description: `${meta.counts.crew_rows.toLocaleString()} crew rows`,
  },
];
---

<Base title="Download" current="data" description="Download ref-ball datasets as CSV or JSON.">
  <section class="section page-header page-header--workspace">
    <div class="container">
      <p class="breadcrumb"><a href="/data">Data</a> / Download</p>
      <h1 class="display">Download</h1>
      <p class="lead">
        CSV and JSON exports ({meta.license.data}). Parquet files are on GitHub Releases.
      </p>
    </div>
  </section>
  <section class="section section--alt section--dither section--flush-top">
    <div class="container">
      <WindowChrome title="downloads.zip" showStatus status={`Code ${meta.license.code} · Data ${meta.license.data}`}>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th>Dataset</th>
                <th>Description</th>
                <th>CSV</th>
                <th>JSON</th>
                <th>Parquet</th>
              </tr>
            </thead>
            <tbody>
              {datasets.map(({ stem, description }) => (
                <tr>
                  <td><code>{stem}</code></td>
                  <td>{description}</td>
                  <td><a class="btn-retro" href={`/downloads/${stem}.csv`} download>CSV</a></td>
                  <td><a class="btn-retro" href={`/downloads/${stem}.json`} download>JSON</a></td>
                  <td><a class="btn-retro" href={release}>Release</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="small muted" style="margin-top:1rem">
          Files are generated from the same parquet sources as the site at build time. Commit
          <code>{meta.git_sha}</code>.
        </p>
        <h2 style="margin-top:1.5rem">Citation</h2>
        <pre class="callout mono small">{citation}</pre>
      </WindowChrome>
    </div>
  </section>
</Base>
