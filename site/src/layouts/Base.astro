---
import '../styles/base.css';
import { getMeta } from '../utils/data';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}

const { title = 'ref-ball', description = 'Watching the Refs Ref.', current } = Astro.props;
const meta = getMeta();
const pageTitle = title === 'ref-ball' ? 'ref-ball' : `${title} · ref-ball`;
const built = new Date(meta.built_at).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="desktop">
      <header class="site-header">
        <div class="container header-inner">
          <a class="brand" href="/">ref-ball</a>
          <button class="nav-toggle" type="button" aria-label="Open menu" data-nav-toggle>Menu</button>
          <nav class="site-nav" data-nav aria-label="Primary">
            <a href="/data" aria-current={current === 'data' ? 'page' : undefined}>Data</a>
            <a href="/the-attention-load" aria-current={current === 'attention-load' ? 'page' : undefined}>Missed Calls</a>
            <a href="/does-harden-choke" aria-current={current === 'dhc' ? 'page' : undefined}>Does Harden Choke?</a>
            <a href="/papers/ssac27" aria-current={current === 'papers' ? 'page' : undefined}>Papers</a>
            <a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a>
          </nav>
        </div>
      </header>

      <slot />

      <footer class="site-footer">
        <div class="container">
          <div class="win95-statusbar win95-statusbar--footer">
            <span>{meta.author}</span>
            <span>Data {meta.license.data}</span>
            <span>ref-ball@{meta.git_sha}</span>
            <span>{built}</span>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline>
      document.querySelector('[data-nav-toggle]')?.addEventListener('click', () => {
        document.querySelector('[data-nav]')?.classList.toggle('open');
      });
    </script>
  </body>
</html>
