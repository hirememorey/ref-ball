# Copy to runpod-drive.env (gitignored) and paste Google Drive share links.
# Each file: Drive → right-click → Share → Anyone with the link → Copy link.
#
# Colab uses MyDrive/landing_foul_clips.zip for clips.
# Frame cache: upload data/processed/landing_foul_frames.npz to Drive, or omit
# GDRIVE_FRAMES_URL to build cache on the pod after clips download (~5–10 min).

GDRIVE_CLIPS_URL='https://drive.google.com/file/d/YOUR_CLIPS_FILE_ID/view?usp=sharing'
# GDRIVE_FRAMES_URL='https://drive.google.com/file/d/YOUR_FRAMES_FILE_ID/view?usp=sharing'

# Optional overrides (Run 7 defaults: head-only, 10 epochs)
# POD_NAME=ref-ball-run6
# PHASE=head
# HEAD_EPOCHS=10
# UNFREEZE_LAYERS=6
# BUILD_FRAME_CACHE=auto
